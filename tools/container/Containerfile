FROM docker.io/library/node:24-bookworm AS node
FROM docker.io/library/ubuntu:24.04

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY requirements-docs.txt /tmp/requirements-docs.txt
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config zip git ca-certificates curl \
        python3 python3-venv libssl-dev liblzma-dev libjpeg-turbo8-dev openssl mosquitto squashfs-tools \
    && useradd --create-home ci \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir platformio pyyaml esptool -r /tmp/requirements-docs.txt

# Match upstream ubuntu-latest's Ubuntu 24.04 / GCC 13 host toolchain.
ENV PATH=/opt/venv/bin:$PATH
ENV PLATFORMIO_CORE_DIR=/root/.platformio
VOLUME /root/.platformio
WORKDIR /w
CMD ["bash"]
